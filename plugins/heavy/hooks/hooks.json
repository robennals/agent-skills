{
  "description": "heavy — denies expensive Bash commands that are not wrapped, and keeps any terminal link pointing at the installed version",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-path.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
